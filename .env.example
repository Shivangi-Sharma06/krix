# Network & RPC
NEXT_PUBLIC_CHAIN_ID=7738577
NEXT_PUBLIC_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
NEXT_PUBLIC_EXPLORER_URL=https://tiramisu.explorer.arkiv.network
NEXT_PUBLIC_FAUCET_URL=https://hub.arkiv.network/faucet

# Explicit Simulation Demo Mode
# When 'true', a prominent warning banner shows: "DEMO MODE - data is simulated locally and is not on the live blockchain"
# When 'false' (default), app connects strictly to the live Tiramisu chain and fails loudly if network or credentials fail.
NEXT_PUBLIC_DEMO_MODE=false

# Private key for scripts/seed.ts (fund with $GLM at https://hub.arkiv.network/faucet)
# Address for key below: 0xc360B9FBB59edDB38042745d315661409Ad16cf9
SEED_PRIVATE_KEY=0x3d05798f7d11bb1c10b83fed8d3b4d76570c31cd66c8e0a8d8d991434c6d7a5e

# IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Optional: Pinata JWT for remote pinning service
PINATA_JWT=
